{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "rootDir": ".",
        "outDir": "./dist",
        "strict": true,
        "skipLibCheck": true,
        "noEmitOnError": true
    },
    "include": ["*.ts"],
    "exclude": ["node_modules", "dist"]
}
